# Standalone CRM-independent API; no Wodify/SendGrid credentials needed.
LEAD_DATABASE_URL=sqlite:///./g3_leads.db
CRM_PROVIDER=hubspot
CRM_SYNC_MODE=test
HUBSPOT_ACCESS_TOKEN=
# Generate a random secret >=32 characters. Only for server-side management calls.
LEAD_ADMIN_KEY=
LEAD_TEAM_EMAIL=info@g3crossfit.com
# Only test is supported. Never sends or schedules external messages.
LEAD_AUTOMATION_MODE=test
# Production: provision schema with deploy/lead-schema.sql first.
LEAD_DATABASE_SCHEMA=
LEAD_INITIALIZE_SCHEMA=true
LEAD_INGEST_KEY=
LEAD_PROCESS_ON_SUBMIT=false
HUBSPOT_INQUIRY_PROPERTY=
