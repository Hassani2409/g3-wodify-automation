{
  "id": "HassaniAnfrageDemo",
  "name": "Hassani | Anfrage → CRM → Mail | lokale n8n Demo",
  "active": false,
  "nodes": [
    {
      "id": "Testlauf-starten",
      "name": "Testlauf starten",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        400
      ],
      "parameters": {}
    },
    {
      "id": "Sechs-synthetische-Testfaelle",
      "name": "Sechs synthetische Testfaelle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        400
      ],
      "parameters": {
        "jsCode": "return [{\"case\":\"valid\",\"Name\":\"Demo Person\",\"Email\":\" demo@example.com \",\"Anliegen\":\"Bitte Beratung zu Anfrageprozessen\",\"Einwilligung\":\"Ja\",\"expected\":\"mail_test_accepted\"},{\"case\":\"duplicate\",\"Name\":\"Demo Person\",\"Email\":\"demo@example.com\",\"Anliegen\":\"Anfrage\",\"Einwilligung\":\"Ja\",\"expected\":\"duplicate\"},{\"case\":\"invalid\",\"Name\":\"X\",\"Email\":\"ungueltig\",\"Anliegen\":\"Anfrage\",\"Einwilligung\":\"Ja\",\"expected\":\"invalid\"},{\"case\":\"crm_failure\",\"Name\":\"CRM Test\",\"Email\":\"crm@example.com\",\"Anliegen\":\"Anfrage\",\"Einwilligung\":\"Ja\",\"expected\":\"crm_failed\"},{\"case\":\"mail_failure\",\"Name\":\"Mail Test\",\"Email\":\"mail@example.com\",\"Anliegen\":\"Anfrage\",\"Einwilligung\":\"Ja\",\"expected\":\"mail_failed\"},{\"case\":\"no_consent\",\"Name\":\"Demo Person\",\"Email\":\"consent@example.com\",\"Anliegen\":\"Anfrage\",\"Einwilligung\":\"Nein\",\"expected\":\"invalid\"}].map(json=>({json}));"
      }
    },
    {
      "id": "Eigene-Anfrage-eingeben",
      "name": "Eigene Anfrage eingeben",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "formTitle": "Hassani — n8n Anfrage-Demo",
        "formDescription": "Echte n8n-Ausführung mit lokalen Test-Schnittstellen. Automatische echte Test-E-Mail über Resend an die eingegebene Adresse. CRM ist simuliert. Einwilligung Ja bestätigt: Dies ist meine Adresse und ich möchte die Demo-Mail erhalten.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Anliegen",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "Einwilligung",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Ja"
                  },
                  {
                    "option": "Nein"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "path": "hassani-anfrage-demo",
          "buttonLabel": "n8n-Test starten",
          "respondWith": "text",
          "responseText": "Anfrage im n8n-Testlauf empfangen. Details stehen unter Executions. Der Versandstatus steht in der Execution."
        }
      },
      "webhookId": "hassani-anfrage-demo"
    },
    {
      "id": "Daten-pruefen-und-normalisieren",
      "name": "Daten pruefen und normalisieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        200
      ],
      "parameters": {
        "jsCode": "return $input.all().map(({json:r})=>{const name=String(r.Name??'').trim(), email=String(r.Email??'').trim().toLowerCase(), message=String(r.Anliegen??'').trim(); const valid=name.length>=2&&name.length<=80&&email.length<=254&&/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)&&message.length>=3&&message.length<=2000&&r.Einwilligung==='Ja';return {json:{case:r.case??'form',name,email,message,consent:r.Einwilligung==='Ja',valid,status:valid?'validated':'invalid',expected:r.expected??null,mode:'local_test'}};});"
      }
    },
    {
      "id": "Gueltige-Anfrage",
      "name": "Gueltige Anfrage",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        740,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "condition",
              "leftValue": "={{ $json.status }}",
              "rightValue": "validated",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
